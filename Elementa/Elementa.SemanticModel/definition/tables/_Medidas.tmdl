			.gir.inv { animation-direction: reverse; }
			.el { fill: #12303A; }
			.el.vl { fill: var(--k); stroke: #fff; stroke-width: .3; }
			.pr { fill: var(--k); } .ne { fill: #C9C3B3; }
			@keyframes gira { to { transform: rotate(360deg); } }
			.at-sim { font: 700 84px/1 Georgia, serif; }
			.at-sim sup { font-size: 34px; vertical-align: top; position: relative; top: 8px; }
			.at-nome { font: italic 22px Georgia, serif; margin-top: 2px; }
			.at-lin { display: flex; gap: 18px; margin: 14px 0 10px; }
			.at-lin div { font: 600 10px 'Segoe UI'; letter-spacing: .14em; color: #7C8A8F; text-transform: uppercase; }
