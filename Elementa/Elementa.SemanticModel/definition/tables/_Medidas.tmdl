			.at-t { font: 600 12px Consolas, monospace; margin: 3px 0; }
			.at-m { margin-top: 8px; font-size: 11px; line-height: 1.45; color: #40565C; padding: 8px 10px; background: var(--kf); border-left: 3px solid var(--k); border-radius: 3px; }
