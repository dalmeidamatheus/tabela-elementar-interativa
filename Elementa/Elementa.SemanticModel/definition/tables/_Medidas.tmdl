			.td-lin { fill: none; stroke: #12303A; stroke-width: 1; opacity: .35; }
			.td-lg { display: inline-flex; align-items: center; gap: 5px; margin-right: 12px; font: 600 10.5px 'Segoe UI'; cursor: pointer; color: #12303A; }
			.td-lg i { width: 10px; height: 10px; border-radius: 50%; background: var(--k); display: inline-block; }
			.td-lg.off { opacity: .35; }
			.td-sel { margin-top: 6px; padding: 8px 12px; border-radius: 10px; background: #F5F2EB; font-size: 12px; color: #12303A; }
