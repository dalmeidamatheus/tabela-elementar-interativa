			.rc-dica { margin: 8px 0 10px; font-size: 11px; color: #7C8A8F; line-height: 1.45; }
			.rc-grupo { margin: 12px 0 6px; font: 800 9.5px 'Segoe UI'; letter-spacing: .2em; color: #7C8A8F; text-transform: uppercase; }
			.rc-eq { font: 700 30px/1.3 Georgia, serif; color: #12303A; margin: 2px 0 12px; word-spacing: 2px; }
			.rc-tp { display: inline-block; padding: 3px 12px; margin-right: 8px; border-radius: 999px; font: 800 10.5px 'Segoe UI'; letter-spacing: .08em; color: #fff; text-transform: uppercase; }
			.rc-nome { font: 700 14px 'Segoe UI'; color: #12303A; }
			.rc-nota { margin: 10px 0 12px; padding: 10px 14px; border-radius: 10px; background: #F5F2EB; font-size: 12px; line-height: 1.5; color: #40565C; border-left: 4px solid var(--c, #F2553C); }
			.rc-cons { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
			.rc-cons span { padding: 3px 10px; border-radius: 8px; background: #EAF6F4; font: 600 11px Consolas, monospace; color: #12303A; }
			.rc-tb { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-bottom: 10px; }
			.rc-tb th { text-align: left; font: 800 9px 'Segoe UI'; letter-spacing: .16em; color: #7C8A8F; text-transform: uppercase; padding: 4px 6px; border-bottom: 1px solid #E6E0D2; }
			.rc-tb td { padding: 5px 6px; border-bottom: 1px dashed #E6E0D2; }
			.rc-tb td.n { font-family: Consolas, monospace; text-align: right; }
			.rc-erro { padding: 14px 16px; border-radius: 12px; background: #FDECE8; color: #9A2E1C; font-size: 13px; line-height: 1.5; }
			.rc-g { width: 90px; height: 30px; box-sizing: border-box; border: 2px solid #E6E0D2; border-radius: 8px; padding: 0 8px; font: 600 12px Consolas, monospace; margin: 0 6px 6px 0; }
