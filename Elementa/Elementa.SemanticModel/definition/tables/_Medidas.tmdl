			    ['CrO4', -2], ['NO3', -1], ['NO2', -1], ['SO4', -2], ['SO3', -2], ['CO3', -2], ['PO4', -3], ['OH', -1], ['CN', -1]];
			  var GAS = { H2: 1, O2: 1, N2: 1, Cl2: 1, F2: 1, CO2: 1, NH3: 1, SO2: 1, H2S: 1, CH4: 1, C2H6: 1, C3H8: 1, C4H10: 1, C2H2: 1, NO: 1, NO2: 1, CO: 1, C2H4: 1 };
