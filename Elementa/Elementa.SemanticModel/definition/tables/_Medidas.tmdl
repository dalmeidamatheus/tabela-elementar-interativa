			      var t = ev.target;
			      if (ev.key === 'Enter' && t && t.getAttribute && t.getAttribute('data-enter') && acoes[t.getAttribute('data-enter')]) { acoes[t.getAttribute('data-enter')](t.value, desenhar); }
			    });
