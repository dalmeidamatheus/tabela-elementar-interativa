			.palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background-color: #F8FAFC; /* Slate 50 */ background-image: linear-gradient(180deg, #F1F5F9 0%, #F8FAFC 100%); }
			.cab { position: absolute; left: 28px; top: 14px; }
			.cab b { display: block; font: 800 30px/1.1 'Segoe UI Variable Display', 'Segoe UI', sans-serif; letter-spacing: -.02em; color: #12303A; }
			.cab b::after { content: ''; display: block; width: 36px; height: 4px; margin-top: 6px; border-radius: 2px; background: #F2553C; }
			.cab span { font-size: 9px; font-weight: 700; letter-spacing: .24em; color: #7C8A8F; text-transform: uppercase; }
			.cx { position: absolute; box-sizing: border-box; background: #FFFFFF; border: 1px solid #E6E0D2; border-radius: 14px; box-shadow: 0 1px 2px rgba(18,48,58,.06), 0 14px 32px rgba(18,48,58,.08); padding: 14px 16px; overflow: hidden; }
			.cx h4 { margin: 0 0 8px; font-size: 9.5px; font-weight: 800; letter-spacing: .2em; color: #7C8A8F; text-transform: uppercase; }
			.bt { display: inline-flex; align-items: center; justify-content: center; height: 30px; padding: 0 14px; margin: 0 6px 6px 0; border-radius: 14px; border: 1px solid #E6E0D2; background: #FFFFFF; color: #12303A; font: 700 11px 'Segoe UI', sans-serif; cursor: pointer; user-select: none; transition: background .12s, transform .12s; }
			.bt:hover { background: #EFE9DC; transform: translateY(-1px); }
			.bt.on { background: #12303A; color: #fff; border-color: #12303A; }
			.bt.ac { background: #F2553C; color: #fff; border-color: #F2553C; }
			.bt.off { opacity: .35; pointer-events: none; }
			.mini { position: relative; }
			.mc { position: absolute; box-sizing: bo"
