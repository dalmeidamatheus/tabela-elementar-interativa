	measure '<CSS> JS Descobertas' =
			
			"#htmlContent { margin: 0; padding: 0; height: 100vh; overflow: hidden; font-family: 'Segoe UI', system-ui, sans-serif; color: #12303A; background: transparent; }
			.htmlViewerEntry { height: 100vh; }
			#statusMessage div { display: none; }
			.sf { font-family: Georgia, 'Times New Roman', serif; }
			.mo { font-family: Consolas, 'Courier New', monospace; }
			.pn { box-sizing: border-box; height: 100vh; padding: 12px 14px; background: #FFFFFF; border: 1px solid #E6E0D2; border-radius: 14px; box-shadow: 0 1px 2px rgba(18,48,58,.06), 0 14px 32px rgba(18,48,58,.08); position: relative; overflow: hidden; }
			.pn-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
			.pn-t { font-size: 9.5px; font-weight: 800; letter-spacing: .2em; color: #7C8A8F; text-transform: uppercase; }
			.pn-s { margin-left: auto; font-size: 10px; color: #7C8A8F; }
			.chip { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .04em; padding: 2px 10px; border-radius: 999px; background: var(--kf); border: 1px solid var(--k); color: #12303A; }
			
			.k-alc { --k: #F2553C; --kf: rgba(242,85,60,.20); }
			.k-alt { --k: #F7A823; --kf: rgba(247,168,35,.20); }
			.k-trans { --k: #3F7CC4; --kf: rgba(63,124,196,.20); }
			.k-pos { --k: #46A87F; --kf: rgba(70,168,127,.20); }
			.k-semi { --k: #A9BC2F; --kf: rgba(169,188,47,.20); }
			.k-ame { --k: #12A3A8; --kf: rgba(18,163,168,.20); }
			.k-hal { --k: #E65C8A; --kf: rgba(230,92,138,.20); }
			.k-nob { --k: #6EC1E4; --kf: rgba(110,193,228,.20); }
			.k-lan { --k: #C8743A; --kf: rgba(200,116,58,.20); }
			.k-act { --k: #9A5A4B; --kf: rgba(154,90,75,.20); }
			.k-desc { --k: #A3A8AD; --kf: rgba(163,168,173,.20); }
			.st-s { --k: #7A8B99; --kf: rgba(122,139,153,.22); }
			.st-l { --k: #2D9CDB; --kf: rgba(45,156,219,.22); }
			.st-g { --k: #E8833A; --kf: rgba(232,131,58,.22); }
			.st-u { --k: #C9C3B3; --kf: rgba(201,195,179,.22); }
			#htmlContent { margin: 0; padding: 0; height: 100vh; overflow: hidden; background-color: #F8FAFC; /* Slate 50 */ background-image: linear-gradient(180deg, #F1F5F9 0%, #F8FAFC 100%); }
			.htmlViewerEntry { height: 100vh; }
			#app-raiz { position: relative; width: 100vw; height: 100vh; overflow: hidden; background-color: #F8FAFC; /* Slate 50 */ background-image: linear-gradient(180deg, #F1F5F9 0%, #F8FAFC 100%); font-family: 'Segoe UI', system-ui, sans-serif; color: #12303A; }
			.palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background-color: #F8FAFC; /* Slate 50 */ background-image: linear-gradient(180deg, #F1F5F9 0%, #F8FAFC 100%); }
			.cab { position: absolute; left: 28px; top: 14px; }
			.cab b { display: block; font: 800 30px/1.1 'Segoe UI Variable Display', 'Segoe UI', sans-serif; letter-spacing: -.02em; color: #12303A; }
			.cab b::after { content: ''; display: block; width: 36px; height: 4px; margin-top: 6px; border-radius: 2px; background: #F2553C; }
			.cab span { font-size: 9px; font-weight: 700; letter-spacing: .24em; color: #7C8A8F; text-transform: uppercase; }
			.cx { position: absolute; box-sizing: border-box; background: #FFFFFF; border: 1px solid #E6E0D2; border-radius: 14px; box-shadow: 0 1px 2px rgba(18,48,58,.06), 0 14px 32px rgba(18,48,58,.08); padding: 14px 16px; overflow: hidden; }
			.cx h4 { margin: 0 0 8px; font-size: 9.5px; font-weight: 800; letter-spacing: .2em; color: #7C8A8F; text-transform: uppercase; }
			.bt { display: inline-flex; align-items: center; justify-content: center; height: 30px; padding: 0 14px; margin: 0 6px 6px 0; border-radius: 14px; border: 1px solid #E6E0D2; background: #FFFFFF; color: #12303A; font: 700 11px 'Segoe UI', sans-serif; cursor: pointer; user-select: none; transition: background .12s, transform .12s; }
			.bt:hover { background: #EFE9DC; transform: translateY(-1px); }
			.bt.on { background: #12303A; color: #fff; border-color: #12303A; }
			.bt.ac { background: #F2553C; color: #fff; border-color: #F2553C; }
			.bt.off { opacity: .35; pointer-events: none; }
			.mini { position: relative; }
			.mc { position: absolute; box-sizing: bo"
			& "rder-box; border-radius: 3px; border-top: 3px solid var(--k); background: var(--kf); text-align: center; cursor: pointer; overflow: hidden; transition: opacity .2s, transform .12s; }
			.mc b { display: block; font: 700 13px Georgia, serif; line-height: 1; margin-top: 8px; }
			.mc i { position: absolute; left: 2px; top: 0; font: 600 6.5px Consolas, monospace; font-style: normal; color: #5C6E73; }
			.mc:hover { transform: translateY(-1px); }
			.mc.sel { outline: 2px solid #12303A; z-index: 2; }
			.mc.dim { opacity: .18; }
			.mc.novo { animation: brilho 1.1s ease-out; }
			.mc.cl b, .mc.cl i { color: #fff; }
			@keyframes brilho { 0% { transform: scale(1.5); box-shadow: 0 0 18px #F2553C; } 100% { transform: scale(1); box-shadow: none; } }
			.mc.p b { font-size: 11.5px; margin-top: 5px; }
			.mc.p i { font-size: 6px; }
			
			.ds-n { font: 700 64px/1 Georgia, serif; }
			.ds-n small { font: 600 14px 'Segoe UI'; color: #7C8A8F; }
			.ds-ano { font: 700 20px Consolas, monospace; color: #F2553C; }
			.ds-sl { width: 100%; margin: 10px 0 4px; accent-color: #F2553C; }
			.ds-li { display: flex; gap: 10px; align-items: baseline; padding: 4px 0; border-bottom: 1px dashed #E6E0D2; font-size: 11.5px; }
			.ds-li b { font: 700 12px Consolas, monospace; width: 38px; }
			.ds-li i { font: 700 14px Georgia, serif; font-style: normal; width: 28px; }
			.ds-li span { color: #5C6E73; }
			.ds-bar { fill: #F2553C; opacity: .35; }
			.ds-bar.on { opacity: 1; }
			.ds-ax { font: 600 8.5px Consolas, monospace; fill: #7C8A8F; text-anchor: middle; }
			.ds-an { font: 700 8.5px 'Segoe UI'; fill: #40565C; }
