-- Formato: cada medida começa com a linha
--   -- @medida <nome> | <pasta>
-- e vai até a próxima. O build_modelo.py grava tudo em _Medidas.tmdl.
--
-- Geradas pelo build (não editar aqui):
--   <CSS> <nome>        a partir de src/css/<nome>.css (+ base.css + cores das categorias)
--   <HTML> Tendência *  a partir de src/dax/tendencia.tpl
--   [JS Dados] e <HTML>/<CSS> JS *  a partir de src/js/
--
-- Seleção do elemento exibido nos painéis (prioridade):
--   1. clique numa posição da grade (tabela desconectada Grade)
--   2. Carbono (Z = 6) quando nada está clicado
-- Destaque por categoria: clique na legenda (tabela desconectada Categorias).
-- Colorir por (tabela desconectada Colorir): 1 Categoria, 2 Estado, 3 Eletroneg., 4 Densidade, 5 Fusão, 6 Descoberta.

-- @medida Modo Colorir | Base
SELECTEDVALUE(Colorir[Ordem], 1)

-- @medida Z Selecionado | Base
VAR _filtrado = ISFILTERED(Grade[Slot])
VAR _z        = IF(_filtrado && HASONEVALUE(Grade[Z]), VALUES(Grade[Z]))
RETURN
    COALESCE(_z, 6)

-- @medida Categoria Destacada | Base
IF(ISFILTERED(Categorias[Slug]) && HASONEVALUE(Categorias[Slug]), VALUES(Categorias[Slug]))

-- @medida Rótulo Métrica | Base
SWITCH([Modo Colorir],
    3, "Eletronegatividade (Pauling)",
    4, "Densidade (g/cm³)",
    5, "Ponto de fusão (°C)",
    6, "Ano de descoberta",
    "Massa atômica (u)")

-- @medida Qtd Elementos | Base
COUNTROWS(ALL(Elementos))

-- @medida <HTML> Fundo | <HTML>
"<div class='fd'></div>"

-- @medida <HTML> Marca | <HTML>
"<div class='mc'><div class='mc-c'><i>1</i><b>El</b></div>"
    & "<div><div class='mc-n'>Elementa</div><div class='mc-s'>atlas dos elementos · " & [Qtd Elementos] & "</div></div></div>"

-- @medida <HTML> Grade | <HTML>
VAR _modo     = [Modo Colorir]
VAR _linha    = SELECTEDVALUE(Grade[Linha])
VAR _z        = SELECTEDVALUE(Grade[Z])
VAR _marc     = SELECTEDVALUE(Grade[Marcador])
VAR _sim      = SELECTEDVALUE(Grade[Simbolo])
VAR _nome     = SELECTEDVALUE(Grade[Nome])
VAR _cat      = SELECTEDVALUE(Grade[CatSlug])
VAR _estado   = SELECTEDVALUE(Grade[Estado])
VAR _en       = SELECTEDVALUE(Grade[EN])
VAR _dens     = SELECTEDVALUE(Grade[DensidadeGcm3])
VAR _fus      = SELECTEDVALUE(Grade[FusaoC])
VAR _ano      = SELECTEDVALUE(Grade[Ano])
VAR _t        = SWITCH(_modo,
                    3, SELECTEDVALUE(Grade[NEn]),
                    4, SELECTEDVALUE(Grade[NDens]),
                    5, SELECTEDVALUE(Grade[NFus]),
                    6, SELECTEDVALUE(Grade[NAno]))
VAR _destaque = [Categoria Destacada]
VAR _estCod   = SWITCH(_estado, "Sólido", "s", "Líquido", "l", "Gasoso", "g", "u")
VAR _numerico = _modo >= 3
VAR _antigo   = _modo = 6 && ISBLANK(_ano)
VAR _semDado  = _numerico && ISBLANK(_t) && NOT _antigo
VAR _h        = ROUND(55 - 70 * COALESCE(_t, 0), 0)
VAR _lum      = ROUND(88 - 46 * COALESCE(_t, 0), 0)
VAR _classeCor = IF(_modo = 1, " k-" & _cat, IF(_modo = 2, " st-" & _estCod, ""))
VAR _estilo   = IF(_numerico && NOT ISBLANK(_t),
                    " style='background:hsl(" & _h & ",78%," & _lum & "%);border-top-color:hsl(" & _h & ",70%," & (_lum - 20) & "%)'",
                    IF(_antigo, " style='background:#D9C9A0;border-top-color:#B8A26B'", ""))
VAR _claro    = IF(_numerico && NOT ISBLANK(_t) && _lum < 58, " cl", "")
VAR _rodape   = SWITCH(_modo,
                    3, IF(ISBLANK(_en), "—", FORMAT(_en, "0.0#", "pt-BR")),
                    4, IF(ISBLANK(_dens), "—", IF(_dens < 0.01, FORMAT(_dens * 1000, "0.0#", "pt-BR") & " g/L", FORMAT(_dens, "0.0#", "pt-BR"))),
                    5, IF(ISBLANK(_fus), "—", FORMAT(_fus, "0", "pt-BR") & "°"),
                    6, IF(ISBLANK(_ano), "antigo", FORMAT(_ano, "0")),
                    _nome)
RETURN
    IF(_linha = 8,
        "<div class='ce gp'></div>",
        IF(NOT ISBLANK(_z),
            "<div class='ce" & _classeCor & IF(_semDado, " nd", "") & _claro
                & IF(NOT ISBLANK(_destaque) && _cat <> _destaque, " ap", "") & "'"
                & IF(_semDado, "", _estilo) & ">"
                & "<i>" & _z & "</i><b>" & _sim & "</b><u>" & _rodape & "</u></div>",
            IF(NOT ISBLANK(_marc),
                "<div class='ce mk'><b>" & _marc & "</b></div>",
                "<div class='ce vz'></div>")))

-- @medida <HTML> Legenda | <HTML>
VAR _slug = SELECTEDVALUE(Categorias[Slug])
VAR _nome = SELECTEDVALUE(Categorias[Categoria])
VAR _qtd  = COUNTROWS(FILTER(ALL(Elementos), Elementos[CatSlug] = _slug))
RETURN
    IF(NOT ISBLANK(_slug),
        "<div class='lg k-" & _slug & IF([Modo Colorir] <> 1, " neutro", "") & "'>"
            & "<i></i><span>" & _nome & "</span><b>" & _qtd & "</b></div>")

-- @medida <HTML> Escala | <HTML>
VAR _modo  = [Modo Colorir]
VAR _todos = ALL(Elementos)
VAR _gradiente = "<div class='es-g'></div>"
RETURN
    SWITCH(_modo,
        1, "<div class='es'><span class='es-t'>Clique numa categoria para destacá-la · clique num elemento para abrir a ficha</span></div>",
        2, "<div class='es'><span class='es-t'>Estado físico a 20 °C</span>"
            & "<span class='es-i st-s'><i></i>Sólido</span><span class='es-i st-l'><i></i>Líquido</span>"
            & "<span class='es-i st-g'><i></i>Gasoso</span><span class='es-i st-u'><i></i>Desconhecido</span></div>",
        3, "<div class='es'><span class='es-t'>Eletronegatividade (Pauling)</span><b>" & FORMAT(MINX(_todos, Elementos[EN]), "0.00", "pt-BR") & "</b>"
            & _gradiente & "<b>" & FORMAT(MAXX(_todos, Elementos[EN]), "0.00", "pt-BR") & "</b><span class='es-n'>cinza = sem dado</span></div>",
        4, "<div class='es'><span class='es-t'>Densidade, escala logarítmica (g/cm³)</span><b>" & FORMAT(MINX(_todos, Elementos[DensidadeGcm3]) * 1000, "0.0#", "pt-BR") & " g/L</b>"
            & _gradiente & "<b>" & FORMAT(MAXX(_todos, Elementos[DensidadeGcm3]), "0.0#", "pt-BR") & "</b><span class='es-n'>cinza = sem dado</span></div>",
        5, "<div class='es'><span class='es-t'>Ponto de fusão (°C)</span><b>" & FORMAT(MINX(_todos, Elementos[FusaoC]), "#,0", "pt-BR") & "</b>"
            & _gradiente & "<b>" & FORMAT(MAXX(_todos, Elementos[FusaoC]), "#,0", "pt-BR") & "</b><span class='es-n'>cinza = sem dado</span></div>",
        "<div class='es'><span class='es-t'>Ano de descoberta</span><span class='es-a'></span><span class='es-n'>antiguidade</span><b>até 1700</b>"
            & _gradiente & "<b>2010</b></div>")

-- @medida <HTML> Ficha | <HTML>
VAR _z     = [Z Selecionado]
VAR _e     = FILTER(ALL(Elementos), Elementos[Z] = _z)
VAR _cat   = MAXX(_e, Elementos[CatSlug])
VAR _sim   = MAXX(_e, Elementos[Simbolo])
VAR _nome  = MAXX(_e, Elementos[Nome])
VAR _massa = MAXX(_e, Elementos[Massa])
VAR _grupo = MAXX(_e, Elementos[Grupo])
VAR _per   = MAXX(_e, Elementos[Periodo])
VAR _bloco = MAXX(_e, Elementos[Bloco])
VAR _catNome = MAXX(_e, Elementos[Categoria])
VAR _posicao = IF(ISBLANK(_grupo), "Período " & _per & " · bloco " & _bloco, "Grupo " & _grupo & " · Período " & _per & " · bloco " & _bloco)
RETURN
    "<div class='fi k-" & _cat & "'>"
        & "<div class='fi-top'><span>" & _z & "</span><span>" & FORMAT(_massa, "0.0##", "pt-BR") & " u</span></div>"
        & "<div class='fi-s'>" & _sim & "</div>"
        & "<div class='fi-n'>" & _nome & "</div>"
        & "<div class='fi-r'><span class='chip'>" & _catNome & "</span></div>"
        & "<div class='fi-p' style='margin-top:6px'>" & _posicao & "</div>"
        & "<div class='fi-ph'>" & _sim & "</div></div>"

-- @medida <HTML> Átomo | <HTML>
VAR _z      = [Z Selecionado]
VAR _e      = FILTER(ALL(Elementos), Elementos[Z] = _z)
VAR _cat    = MAXX(_e, Elementos[CatSlug])
VAR _cam    = MAXX(_e, Elementos[Camadas])
VAR _massa  = MAXX(_e, Elementos[Massa])
VAR _val    = MAXX(_e, Elementos[Valencia])
VAR _n      = PATHLENGTH(_cam)
VAR _passo  = IF(_n > 1, MIN(22, DIVIDE(68, _n - 1)), 0)
VAR _neutrons = ROUND(_massa, 0) - _z
VAR _orbitas = CONCATENATEX(GENERATESERIES(1, _n),
        "<circle class='orb' cx='100' cy='100' r='" & FORMAT(24 + ([Value] - 1) * _passo, "0.0", "en-US") & "'/>", "")
VAR _eletrons = CONCATENATEX(GENERATESERIES(1, _n),
        VAR _k   = [Value]
        VAR _r   = 24 + (_k - 1) * _passo
        VAR _c   = VALUE(PATHITEM(_cam, _k))
        VAR _dir = IF(MOD(_k, 2) = 0, " inv", "")
        RETURN
            "<g class='gir" & _dir & "' style='animation-duration:" & (7 + 5 * _k) & "s'>"
                & CONCATENATEX(GENERATESERIES(1, _c),
                    VAR _a = 2 * PI() * ([Value] - 1) / _c + _k
                    RETURN "<circle class='el" & IF(_k = _n, " vl", "") & "' cx='" & FORMAT(100 + _r * COS(_a), "0.00", "en-US")
                        & "' cy='" & FORMAT(100 + _r * SIN(_a), "0.00", "en-US") & "' r='2.4'/>", "")
                & "</g>", "")
VAR _camadasTxt = SUBSTITUTE(_cam, "|", " · ")
RETURN
    "<div class='at k-" & _cat & "'>"
        & "<svg viewBox='0 0 200 200'>" & _orbitas
        & "<circle class='nu' cx='100' cy='100' r='10' opacity='.22'/><circle class='nu' cx='100' cy='100' r='6.5'/>"
        & _eletrons & "</svg>"
        & "<div class='at-i'><b>Átomo neutro</b>p⁺ <em>" & _z & "</em><br>n⁰ <em>" & _neutrons & "</em><br>e⁻ <em>" & _z & "</em><br>"
        & "<b style='margin-top:8px'>Camadas</b><em>" & _camadasTxt & "</em><br>valência <em>" & _val & "</em></div></div>"

-- @medida <HTML> Dados | <HTML>
VAR _z      = [Z Selecionado]
VAR _e      = FILTER(ALL(Elementos), Elementos[Z] = _z)
VAR _cat    = MAXX(_e, Elementos[CatSlug])
VAR _estado = MAXX(_e, Elementos[Estado])
VAR _fusC   = MAXX(_e, Elementos[FusaoC])
VAR _ebuK   = MAXX(_e, Elementos[EbulicaoK])
VAR _dens   = MAXX(_e, Elementos[DensidadeGcm3])
VAR _en     = MAXX(_e, Elementos[EN])
VAR _oxi    = MAXX(_e, Elementos[Oxidacoes])
VAR _cfg    = MAXX(_e, Elementos[ConfigNobre])
VAR _desc   = MAXX(_e, Elementos[Descoberta])
VAR _fusTxt = IF(ISBLANK(_fusC), "—", FORMAT(_fusC, "#,0.#", "pt-BR") & " °C")
VAR _ebuTxt = IF(ISBLANK(_ebuK), "—", FORMAT(_ebuK - 273.15, "#,0.#", "pt-BR") & " °C")
VAR _densTxt = IF(ISBLANK(_dens), "—", IF(_dens < 0.01, FORMAT(_dens * 1000, "0.0##", "pt-BR") & " g/L", FORMAT(_dens, "0.0##", "pt-BR") & " g/cm³"))
VAR _enTxt  = IF(ISBLANK(_en), "—", FORMAT(_en, "0.0#", "pt-BR"))
RETURN
    "<div class='pn k-" & _cat & "'><div class='pn-h'><span class='pn-t'>Propriedades</span></div>"
        & "<div class='dr'><span>Estado a 20 °C</span><b>" & _estado & "</b></div>"
        & "<div class='dr'><span>Fusão</span><b>" & _fusTxt & "</b></div>"
        & "<div class='dr'><span>Ebulição</span><b>" & _ebuTxt & "</b></div>"
        & "<div class='dr'><span>Densidade</span><b>" & _densTxt & "</b></div>"
        & "<div class='dr'><span>Eletronegatividade</span><b>" & _enTxt & "</b></div>"
        & "<div class='dr'><span>Oxidação</span><b>" & IF(ISBLANK(_oxi), "—", _oxi) & "</b></div>"
        & "<div class='dr'><span>Configuração</span><b class='sm'>" & _cfg & "</b></div>"
        & "<div class='dr'><span>Descoberta</span><b class='sm'>" & _desc & "</b></div></div>"

-- @medida <HTML> Fato | <HTML>
VAR _z    = [Z Selecionado]
VAR _e    = FILTER(ALL(Elementos), Elementos[Z] = _z)
VAR _cat  = MAXX(_e, Elementos[CatSlug])
VAR _fato = MAXX(_e, Elementos[Fato])
RETURN
    "<div class='ft k-" & _cat & "'><div class='ft-t'>VOCÊ SABIA?</div><div class='ft-x'>" & _fato & "</div></div>"
